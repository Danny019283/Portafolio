---
const technologies = [
	'Astro',
	'JavaScript',
	'TypeScript',
	'HTML',
	'CSS',
	'Git',
];

const softSkills = [
	'Comunicacion efectiva',
	'Trabajo en equipo',
	'Aprendizaje rapido',
	'Resolucion de problemas',
];

const education = [
	{
		title: 'Nombre de tu carrera o certificacion',
		place: 'Institucion o centro de estudios',
		period: '2020 - 2024',
		description: 'Agrega aqui una breve nota sobre tu formacion, enfoque o logros principales.',
	},
	{
		title: 'Curso, diplomado o especialidad',
		place: 'Plataforma o academia',
		period: '2024',
		description: 'Puedes usar este espacio para formacion complementaria relevante.',
	},
];

const projects = [
	{
		name: 'Proyecto destacado 01',
		description: 'Describe aqui el problema que resolviste, la tecnologia usada y el impacto del proyecto.',
		stack: 'Astro · JavaScript · CSS',
		link: 'https://github.com/tu-usuario/proyecto-1',
	},
	{
		name: 'Proyecto destacado 02',
		description: 'Usa este bloque para mostrar una app, API o sistema que te represente bien.',
		stack: 'Node.js · SQL · API REST',
		link: 'https://github.com/tu-usuario/proyecto-2',
	},
	{
		name: 'Proyecto destacado 03',
		description: 'Incluye una descripcion breve y clara para que sea facil de leer por reclutadores.',
		stack: 'React · Firebase · UI',
		link: 'https://github.com/tu-usuario/proyecto-3',
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Portfolio personal con secciones para presentacion, tecnologias, estudios y proyectos."
		/>
		<title>Tu Nombre | Portfolio</title>
		<style>
			:root {
				color-scheme: dark;
				--bg: #09090f;
				--bg-soft: rgba(15, 18, 34, 0.74);
				--surface: rgba(18, 24, 45, 0.72);
				--surface-strong: rgba(28, 36, 65, 0.88);
				--border: rgba(162, 178, 255, 0.18);
				--text: #eff3ff;
				--muted: #b5bed8;
				--accent: #8b5cf6;
				--accent-2: #22d3ee;
				--accent-3: #f472b6;
				--shadow: 0 24px 80px rgba(4, 8, 24, 0.45);
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
				background:
					radial-gradient(circle at top left, rgba(139, 92, 246, 0.24), transparent 28%),
					radial-gradient(circle at top right, rgba(34, 211, 238, 0.2), transparent 24%),
					radial-gradient(circle at bottom center, rgba(244, 114, 182, 0.14), transparent 28%),
					var(--bg);
				color: var(--text);
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			main {
				width: min(1120px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 1.25rem 0 4rem;
			}

			.nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem 1.25rem;
				background: rgba(9, 9, 15, 0.55);
				border: 1px solid var(--border);
				border-radius: 999px;
				backdrop-filter: blur(16px);
				position: sticky;
				top: 1rem;
				z-index: 10;
				box-shadow: var(--shadow);
			}

			.nav__brand {
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.nav__links {
				display: flex;
				flex-wrap: wrap;
				justify-content: flex-end;
				gap: 0.85rem;
				font-size: 0.95rem;
				color: var(--muted);
			}

			.hero {
				display: grid;
				grid-template-columns: 1.4fr 0.9fr;
				gap: 1.5rem;
				padding: 4rem 0 2rem;
				align-items: stretch;
			}

			.panel {
				position: relative;
				background: linear-gradient(180deg, var(--surface), rgba(10, 14, 28, 0.88));
				border: 1px solid var(--border);
				border-radius: 28px;
				padding: 1.5rem;
				backdrop-filter: blur(20px);
				box-shadow: var(--shadow);
				overflow: hidden;
			}

			.panel::after {
				content: '';
				position: absolute;
				inset: auto -20% -35% auto;
				width: 220px;
				height: 220px;
				background: radial-gradient(circle, rgba(139, 92, 246, 0.22), transparent 70%);
				pointer-events: none;
			}

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				padding: 0.45rem 0.85rem;
				border-radius: 999px;
				background: rgba(139, 92, 246, 0.14);
				border: 1px solid rgba(139, 92, 246, 0.22);
				color: #ddd6fe;
				font-size: 0.9rem;
			}

			h1 {
				font-size: clamp(2.8rem, 8vw, 5.8rem);
				line-height: 0.96;
				margin: 1.1rem 0 1rem;
			}

			.hero p {
				max-width: 62ch;
				color: var(--muted);
				font-size: 1.05rem;
				line-height: 1.7;
			}

			.hero__accent {
				background: linear-gradient(120deg, var(--accent-2), var(--accent-3));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.9rem;
				margin-top: 1.75rem;
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.95rem 1.3rem;
				border-radius: 999px;
				font-weight: 700;
				transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
			}

			.button:hover {
				transform: translateY(-2px);
			}

			.button--primary {
				background: linear-gradient(120deg, var(--accent), var(--accent-2));
				color: #050816;
			}

			.button--ghost {
				border: 1px solid var(--border);
				background: rgba(255, 255, 255, 0.03);
			}

			.hero__stats {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.85rem;
				margin-top: 2rem;
			}

			.stat {
				padding: 1rem;
				border-radius: 20px;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid rgba(255, 255, 255, 0.06);
			}

			.stat strong {
				display: block;
				font-size: 1.4rem;
				margin-bottom: 0.3rem;
			}

			.photo-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 1.25rem;
				min-height: 100%;
			}

			.photo-placeholder {
				min-height: 360px;
				border-radius: 24px;
				border: 1px dashed rgba(255, 255, 255, 0.18);
				background:
					linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01)),
					radial-gradient(circle at top, rgba(34, 211, 238, 0.22), transparent 35%),
					radial-gradient(circle at bottom, rgba(139, 92, 246, 0.22), transparent 40%);
				display: grid;
				place-items: center;
				text-align: center;
				padding: 1.25rem;
				color: var(--muted);
			}

			.photo-placeholder strong {
				display: block;
				font-size: 1.05rem;
				color: var(--text);
				margin-bottom: 0.5rem;
			}

			.section {
				padding: 1rem 0;
			}

			.section__heading {
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				margin-bottom: 1.3rem;
			}

			.section__heading h2 {
				font-size: clamp(1.8rem, 4vw, 2.8rem);
				margin: 0;
			}

			.section__heading p {
				margin: 0;
				color: var(--muted);
				max-width: 60ch;
				line-height: 1.7;
			}

			.grid {
				display: grid;
				gap: 1rem;
			}

			.tech-grid {
				grid-template-columns: repeat(6, minmax(0, 1fr));
			}

			.tech-pill,
			.soft-card,
			.timeline-item,
			.project-card {
				background: var(--bg-soft);
				border: 1px solid var(--border);
				border-radius: 22px;
				backdrop-filter: blur(18px);
				box-shadow: var(--shadow);
			}

			.tech-pill {
				padding: 1rem;
				text-align: center;
				font-weight: 700;
			}

			.soft-grid,
			.project-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.soft-card,
			.timeline-item,
			.project-card {
				padding: 1.25rem;
			}

			.soft-card h3,
			.timeline-item h3,
			.project-card h3 {
				margin: 0 0 0.65rem;
			}

			.soft-card p,
			.timeline-item p,
			.project-card p {
				margin: 0;
				color: var(--muted);
				line-height: 1.7;
			}

			.timeline {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.meta {
				display: inline-flex;
				padding: 0.35rem 0.7rem;
				border-radius: 999px;
				margin-bottom: 0.85rem;
				font-size: 0.85rem;
				background: rgba(34, 211, 238, 0.1);
				color: #a5f3fc;
			}

			.project-card {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.project-card__footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-top: auto;
			}

			.stack {
				font-size: 0.9rem;
				color: #cbd5f5;
			}

			.link-inline {
				font-weight: 700;
				color: #e9d5ff;
			}

			.footer {
				padding: 1rem 0 0;
				text-align: center;
				color: var(--muted);
			}

			@media (max-width: 960px) {
				.hero,
				.soft-grid,
				.timeline,
				.project-grid {
					grid-template-columns: 1fr;
				}

				.tech-grid {
					grid-template-columns: repeat(3, minmax(0, 1fr));
				}

				.nav {
					border-radius: 28px;
				}
			}

			@media (max-width: 640px) {
				main {
					width: min(100% - 1rem, 1120px);
				}

				.nav {
					align-items: flex-start;
					flex-direction: column;
				}

				.nav__links,
				.hero__stats,
				.tech-grid {
					grid-template-columns: 1fr 1fr;
				}

				.nav__links {
					display: grid;
					width: 100%;
				}

				.hero {
					padding-top: 2.5rem;
				}

				.panel,
				.soft-card,
				.timeline-item,
				.project-card,
				.tech-pill {
					border-radius: 20px;
				}

				.photo-placeholder {
					min-height: 280px;
				}
			}

			@media (max-width: 440px) {
				.hero__stats,
				.tech-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<nav class="nav" aria-label="Navegacion principal">
				<a class="nav__brand" href="#inicio">Tu Portfolio</a>
				<div class="nav__links">
					<a href="#sobre-mi">Sobre mi</a>
					<a href="#tecnologias">Tecnologias</a>
					<a href="#habilidades">Habilidades</a>
					<a href="#estudios">Estudios</a>
					<a href="#proyectos">Proyectos</a>
				</div>
			</nav>

			<section class="hero" id="inicio">
				<div class="panel" id="sobre-mi">
					<span class="eyebrow">Disponible para nuevas oportunidades</span>
					<h1>
						Tu nombre,<br />
						<span class="hero__accent">tu primera gran impresion.</span>
					</h1>
					<p>
						Aqui ira tu presentacion principal. Puedes resumir quien eres, que tipo de proyectos te
						gustan, que valor aportas y por que vale la pena conocerte profesionalmente.
					</p>
					<div class="actions">
						<a class="button button--primary" href="https://github.com/tu-usuario" target="_blank" rel="noreferrer">
							Ver perfil de GitHub
						</a>
						<a class="button button--ghost" href="#proyectos">Explorar proyectos</a>
					</div>
					<div class="hero__stats">
						<div class="stat">
							<strong>+3</strong>
							<span>Proyectos para mostrar</span>
						</div>
						<div class="stat">
							<strong>+6</strong>
							<span>Tecnologias destacadas</span>
						</div>
						<div class="stat">
							<strong>100%</strong>
							<span>Personalizable con tu informacion</span>
						</div>
					</div>
				</div>

				<aside class="panel photo-card" aria-label="Foto de perfil y enlace principal">
					<div class="photo-placeholder">
						<div>
							<strong>Espacio para tu foto</strong>
							<span>
								Puedes reemplazar este bloque por una imagen personal cuando quieras completar el
								curriculum.
							</span>
						</div>
					</div>
					<div>
						<span class="meta">GitHub principal</span>
						<h2 style="margin: 0 0 0.6rem;">github.com/tu-usuario</h2>
						<p style="margin: 0; color: var(--muted); line-height: 1.7;">
							Actualiza este enlace con tu perfil real para que funcione como acceso directo a tu trabajo.
						</p>
					</div>
				</aside>
			</section>

			<section class="section" id="tecnologias">
				<div class="section__heading">
					<span class="eyebrow">Stack</span>
					<h2>Tecnologias que puedes destacar</h2>
					<p>
						Usa esta seccion para listar las herramientas con las que trabajas o que deseas resaltar en tu perfil.
					</p>
				</div>
				<div class="grid tech-grid">
					{technologies.map((technology) => <div class="tech-pill">{technology}</div>)}
				</div>
			</section>

			<section class="section" id="habilidades">
				<div class="section__heading">
					<span class="eyebrow">Soft skills</span>
					<h2>Habilidades blandas</h2>
					<p>
						Este bloque ayuda a complementar el perfil tecnico con tu forma de trabajar y colaborar con otras personas.
					</p>
				</div>
				<div class="grid soft-grid">
					{softSkills.map((skill) => (
						<article class="soft-card">
							<h3>{skill}</h3>
							<p>
								Agrega aqui una breve frase que explique como aplicas esta habilidad en proyectos o equipos reales.
							</p>
						</article>
					))}
				</div>
			</section>

			<section class="section" id="estudios">
				<div class="section__heading">
					<span class="eyebrow">Formacion</span>
					<h2>Estudios y preparacion</h2>
					<p>
						Deja aqui tu carrera, certificaciones o cursos importantes para reforzar tu perfil profesional.
					</p>
				</div>
				<div class="grid timeline">
					{education.map((item) => (
						<article class="timeline-item">
							<span class="meta">{item.period}</span>
							<h3>{item.title}</h3>
							<p style="margin-bottom: 0.7rem; color: #e2e8f0;">{item.place}</p>
							<p>{item.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="section" id="proyectos">
				<div class="section__heading">
					<span class="eyebrow">Portfolio</span>
					<h2>Proyectos con enlace a GitHub</h2>
					<p>
						Cada tarjeta esta pensada para mostrar una descripcion clara, el stack usado y un enlace directo al repositorio.
					</p>
				</div>
				<div class="grid project-grid">
					{projects.map((project) => (
						<article class="project-card">
							<div>
								<span class="meta">{project.stack}</span>
								<h3>{project.name}</h3>
								<p>{project.description}</p>
							</div>
							<div class="project-card__footer">
								<span class="stack">Repositorio del proyecto</span>
								<a class="link-inline" href={project.link} target="_blank" rel="noreferrer">
									Ver en GitHub
								</a>
							</div>
						</article>
					))}
				</div>
			</section>

			<footer class="footer">
				<p>Plantilla lista para completar con tu informacion real, enlaces e imagen personal.</p>
			</footer>
		</main>
	</body>
</html>
